# Copy to .env and fill in. Never commit .env.

# Postgres — docker-compose default for local development
DATABASE_URL=postgres://vcs:vcs@localhost:5432/vcs_crm

# Better Auth
BETTER_AUTH_SECRET=change-me-openssl-rand-base64-32
BETTER_AUTH_URL=http://localhost:3000

# G6 — must be SET and STABLE across restarts and deploys, or Server Actions
# fail after a restart in ways that look random (docs/03-tech-stack.md §5.6).
# Generate once: openssl rand -base64 32
NEXT_SERVER_ACTIONS_ENCRYPTION_KEY=change-me-openssl-rand-base64-32

# PDF render service (docker-compose runs it on :8080 locally)
PDF_SERVICE_URL=http://localhost:8080
PDF_SERVICE_SECRET=change-me-shared-secret

# Bearer token for /api/cron/followups — system cron calls this daily
CRON_SECRET=change-me-cron-secret

# Uploaded files (receipts, product images) live outside the repo
MEDIA_ROOT=./media
